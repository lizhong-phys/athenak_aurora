# Partial input, loaded AFTER the old checkpoint with -r ... -i this_file.
# Keep mesh, radiation configuration, rho0 and units from the checkpoint.
# In particular, units/density_cgs MUST stay 1e-6; final code density is 1e-6.

<job>
basename = bhl_density_ramp

<time>
nlim = -1
# The pgen sets absolute tlim = original restart time + 30000 + 20000.

<problem>
density_ramp_final_cgs = 1.0e-12
density_ramp_duration  = 30000.0
density_ramp_hold      = 20000.0
density_ramp_scale_b   = true   # constant gas beta; false keeps original B
density_ramp_set_tlim  = true
density_ramp_track_floors = true
density_ramp_local_entropy = true
# Entropy coefficients from the standalone reference runs (ambient code rho=1).
density_ramp_floor_mid_cgs = 1.0e-9
density_ramp_floor_low_cgs = 1.0e-12
density_ramp_sfloor_mid = 1.0e-10
density_ramp_sfloor_low = 1.0e-9
# Omit density_ramp_start: first restart time is saved automatically.

<mhd>
# Initial floors; the pgen scales them with the current inflow density.
# Original anchor values are saved separately for all subsequent restarts.
dfloor = 1.0e-7
pfloor = 3.3333333333333335e-13

<coord>
dexcise = 1.0e-7
pexcise = 3.3333333333333335e-13

<output1>
# Write a fresh history header for the added reservoir diagnostics.
file_number = 0
last_time = -1.0
