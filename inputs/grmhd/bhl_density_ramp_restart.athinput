# Partial input, loaded AFTER the original dense checkpoint with -r ... -i.
# Keep mesh, radiation, temperature, entropy law and units from the checkpoint.
# units/density_cgs stays 1e-6; the final inflow density is 1e-6 in code units.

<job>
basename = bhl_density_ramp

<time>
nlim = -1
# The pgen sets absolute tlim = original restart time + 30000 + 20000.

<problem>
density_ramp_final_cgs = 1.0e-12
density_ramp_duration  = 30000.0
density_ramp_hold      = 20000.0
density_ramp_scale_b   = true   # preserve original total-pressure beta
density_ramp_set_tlim  = true
# Compatibility flags: floors are fixed, and the original entropy law is used.
density_ramp_track_floors = false
density_ramp_local_entropy = false
# Omit density_ramp_start: the first restart time is saved automatically.

<mhd>
# Fixed final-target floors, used from the first restart through the final hold.
dfloor = 1.0e-13
pfloor = 3.3333333333333335e-19
# sfloor, sfloor1/2 and rho1/2 remain exactly as saved in the dense checkpoint.

<coord>
dexcise = 1.0e-13
pexcise = 3.3333333333333335e-19

<output1>
# Write a fresh history header for the added reservoir diagnostics.
file_number = 0
last_time = -1.0
