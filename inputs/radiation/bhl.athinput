<comment>
problem   = xin_bhl (BHL wind onto Kerr BH; +z injection on inner_x3)
reference = xin_bhl.cpp

<job>
basename  = xin_bhl

<mesh>
nghost = 4        # Number of ghost cells

nx1    = 128       # number of cells in x1-direction
x1min  = -128.0    # 256 r_g box
x1max  =  128.0
ix1_bc = user      # outflow (zero-gradient copy)
ox1_bc = user      # outflow

nx2    = 128
x2min  = -128.0
x2max  =  128.0
ix2_bc = user      # outflow
ox2_bc = user      # outflow

nx3    = 128
x3min  = -128.0
x3max  =  128.0
ix3_bc = user      # INJECTION: -z face is the upstream wind boundary
ox3_bc = user      # outflow (downstream wake exit)

<meshblock>
nx1  = 64
nx2  = 64
nx3  = 64

<mesh_refinement>
refinement = static
prolong_primitives = true

<refined_region1>
level = 1
x1min = -64.0
x1max =  64.0
x2min = -64.0
x2max =  64.0
x3min = -64.0
x3max =  64.0

<refined_region2>
level = 2
x1min = -32.0
x1max =  32.0
x2min = -32.0
x2max =  32.0
x3min = -32.0
x3max =  32.0

<refined_region3>
level = 3
x1min = -16.0
x1max =  16.0
x2min = -16.0
x2max =  16.0
x3min = -16.0
x3max =  16.0

<refined_region4>
level = 4
x1min = -8.0
x1max =  8.0
x2min = -8.0
x2max =  8.0
x3min = -8.0
x3max =  8.0

<time>
evolution  = dynamic   # dynamic/kinematic/static
integrator = rk2       # time integration algorithm
cfl_number = 0.3       # CFL number
nlim       = -1        # cycle limit (-1 = no limit)
tlim       = 5000.0    # end time (M); ~2.5 box flow times at v_wind=0.1c
ndiag      = 100       # cycles between diagnostic output

<coord>
general_rel = true     # general relativity
a           = 0.9375   # black hole spin a/M (0 <= |a/M| < 1)
excise      = true     # excise r_ks <= 1.0 from the evolution
dexcise     = 1.0e-7   # density floor inside excision
pexcise     = 3.3333333333333335e-13 # pressure floor inside excision

<mhd>
eos         = ideal    # adiabatic ideal-gas EOS -> T evolves dynamically
reconstruct = ppm4     # spatial reconstruction
rsolver     = hlle     # Riemann solver
dfloor      = 1.0e-7   # density floor
pfloor      = 3.3333333333333335e-13 # pressure floor
sfloor      = 1.0e-12
sfloor1     = 3.0e-10
sfloor2     = 1.0e-9
rho1        = 1.0e0
rho2        = 1.0e2
gamma       = 1.6666666666666667
fofc        = true     # first-order flux correction
gamma_max   = 20.0     # ceiling on Lorentz factor

<radiation>
reconstruct   = plm    # reconstruction method (radiation)
rotate_geo    = false  # rotate geodesic grid
nlevel        = 2      # geodesic-grid angular resolution
power_opacity = true   # absorption opacity ~ T^(-3.5) (free-free)
compton       = true   # enable Compton scattering
kappa_s       = 0.34   # scattering opacity (Thomson)
n_0_floor     = 0.1    # floor on n_0
correct_radsrc_opacity = false
dfloor_opacity         = 1.e-14
dens_trunc_max         = 1.e-5
tau_truncation         = 1.5e-4
sigmoid_residual       = 1.e-2

<units>
bhmass_msun = 10.0     # BH mass (solar masses)
density_cgs = 1.0e-7   # rho=1 (code) == 1e-7 g/cm^3
mu          = 0.6      # mean molecular weight (ionized H)

<problem>
rho0        = 1.0      # uniform background density (code units)
t0          = 1.52e-9  # uniform temperature, T = 1e4 K
v_wind      = 0.1      # wind speed along +z in units of c (uu^z at injection face)
beta_target = 0.05     # plasma beta target -> b0 = sqrt(2*p_tot/beta_target)
user_hist   = true     # enable WindFluxes history function

<output1>
file_type      = hst   # history output (mdot, edot, ldot, phi at 3 radii)
dt             = 10.0
user_hist_only = true

<output2>
file_type = bin              # full 3D dump of rad-MHD primitives
id        = full
variable  = rad_mhd_w_bcc
dt        = 100.0

<output3>
file_type = bin              # x1=0 slice (y-z plane: shows wind impacting BH)
slice_x1  = 0.0
id        = slice_x
variable  = rad_mhd_w_bcc
dt        = 10.0

<output4>
file_type = bin              # x3=0 slice (x-y plane, equatorial)
slice_x3  = 0.0
id        = slice_z
variable  = rad_mhd_w_bcc
dt        = 10.0

<output5>
file_type = rst              # restart dumps
dt        = 200.0
